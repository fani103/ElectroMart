# ===== BACKEND-ONLY SECRETS (never put these in frontend files or GitHub) =====
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URLS=http://localhost:5500,http://127.0.0.1:5500
# Public URL of the frontend (used in email links)
FRONTEND_URL=http://localhost:5500

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=product-images

# Razorpay - TEST MODE ONLY (keys must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Optional: only if you create a webhook in the Razorpay test dashboard
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ElectroMart <onboarding@resend.dev>
SUPPORT_EMAIL=support@example.com

# Store rules
COD_ENABLED=true
LOW_STOCK_THRESHOLD=5
SHIPPING_FLAT=99
FREE_SHIPPING_ABOVE=5000
TAX_RATE_PERCENT=0
MAX_QTY_PER_ITEM=10
